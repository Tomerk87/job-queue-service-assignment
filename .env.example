# All variables are optional; docker-compose.yml sets working values for the containers.
DATABASE_URL=postgresql+psycopg://jobqueue:jobqueue@postgres:5432/jobqueue
REDIS_URL=redis://redis:6379/0
# Idempotency keys are retained at least this long (minimum 24).
IDEMPOTENCY_TTL_HOURS=24
# A scheduled_at at most this far in the past is accepted and runs immediately.
SCHEDULE_PAST_TOLERANCE_SECONDS=30
# Socket timeout for best-effort Redis calls.
REDIS_TIMEOUT_SECONDS=0.5
# Worker: identity (default <hostname>-<pid>), idle DB poll interval (max 2s), claim lease.
# WORKER_ID=worker-1
WORKER_POLL_INTERVAL_SECONDS=2
LEASE_SECONDS=30
# Mock handlers: webhook simulated failure probability, per-item batch delay.
WEBHOOK_FAILURE_RATE=0.2
BATCH_ITEM_DELAY_SECONDS=0.2
